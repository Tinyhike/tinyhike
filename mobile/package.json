{
  "name": "tinyhike-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "TS_IP=$(tailscale ip -4) && REACT_NATIVE_PACKAGER_HOSTNAME=$TS_IP APP_VARIANT=development expo start --dev-client --host lan",
    "start:tunnel": "APP_VARIANT=development expo start --dev-client --tunnel",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rnmapbox/maps": "^10.3.11",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
