# mobile/.env (chmod 600, never committed). Read by Metro and inlined into the
# JavaScript bundle, so only public values: EXPO_PUBLIC_* ends up in the app.
# EAS builds get the same variable from EAS environment variables, not from here.

# Public Mapbox token dedicated to the app (pk., no URL restriction: a native
# app sends no Origin header)
EXPO_PUBLIC_MAPBOX_TOKEN=
